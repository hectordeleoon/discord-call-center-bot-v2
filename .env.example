# ============================================
# CONFIGURACIÓN BOT DISCORD - EL PATIO RP
# ============================================

# Token del bot (obtén en: https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=tu_token_aqui

# ============================================
# CANALES DE VOZ
# ============================================

# Canal donde usuarios esperan
WAITING_CHANNEL_ID=

# Canal donde staff disponible espera
STAFF_AVAILABLE_CHANNEL_ID=

# Canal donde staff ocupado está
STAFF_BUSY_CHANNEL_ID=

# Canal de texto para notificaciones staff
STAFF_TEXT_CHANNEL_ID=

# ============================================
# CANALES DE SOPORTE (separados por comas)
# ============================================

SUPPORT_CHANNELS=canal1_id,canal2_id,canal3_id

# ============================================
# ROLES (separados por comas)
# ============================================

# Roles de staff
STAFF_ROLES=rol1_id,rol2_id

# Roles VIP
VIP_ROLES=rol_vip_id

# Roles donadores
DONATOR_ROLES=rol_donador_id

# ============================================
# CONFIGURACIÓN DE AUDIO
# ============================================

# Intervalo de repetición de voz (milisegundos)
VOICE_REPEAT_INTERVAL=60000

# Tiempo antes de asignar staff (milisegundos)
TIME_BEFORE_ASSIGN=5000

# Intervalo de actualización de cola (milisegundos)
QUEUE_UPDATE_INTERVAL=10000
